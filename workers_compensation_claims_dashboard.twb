    <worksheet name='Return to Work and Days to Close for Closed Claims'>
      <table>
        <view>
          <datasources>
            <datasource caption='workers_compensation_claims_clean' name='federated.1q3aj3o1wy39j518jfnwr1ongmix' />
          </datasources>
          <datasource-dependencies datasource='federated.1q3aj3o1wy39j518jfnwr1ongmix'>
            <column caption='Days to Close (closed only)' datatype='integer' name='[Calculation_0032290418700290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [claim_status] = &quot;Closed&quot; THEN DATEDIFF(&apos;day&apos;,[injury_date],[closure_date]) END' />
            </column>
            <column caption='RTW Days (Closed only)' datatype='real' name='[Calculation_0032290419998723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [claim_status] = &quot;Closed&quot; THEN [return_to_work_days] END' />
            </column>
            <column caption='if avg([RTW Days (Closed only)])=window_max(avg([RTW Days (Cl...' datatype='string' name='[Calculation_0032291844165662]' role='measure' type='nominal' user:unnamed='Return to Work for Closed and Unclosed'>
              <calculation class='tableau' formula='if avg([Calculation_0032290419998723])=window_max(avg([Calculation_0032290419998723])) &#10;then &apos;maxrtw&apos; ELSEIF avg([Calculation_0032290419998723])=window_min(avg([Calculation_0032290419998723])) &#10;then &apos;minrtw&apos; ELSEIF avg([Calculation_0032290418700290])=window_max(avg([Calculation_0032290418700290])) &#10;then &apos;maxdtc&apos; ELSEIF avg([Calculation_0032290418700290])=window_min(avg([Calculation_0032290418700290])) &#10;then &apos;mindtc&apos; else &apos;other&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Calculation_0032290418700290]' derivation='Avg' name='[avg:Calculation_0032290418700290:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0032290419998723]' derivation='Avg' name='[avg:Calculation_0032290419998723:qk]' pivot='key' type='quantitative' />
            <column caption='Cause Of Injury' datatype='string' name='[cause_of_injury]' role='dimension' type='nominal' />
            <column caption='Claim Status' datatype='string' name='[claim_status]' role='dimension' type='nominal' />
            <column caption='Closure Date' datatype='date' name='[closure_date]' role='dimension' type='ordinal' />
            <column caption='Injury Date' datatype='date' name='[injury_date]' role='dimension' type='ordinal' />
            <column-instance column='[cause_of_injury]' derivation='None' name='[none:cause_of_injury:nk]' pivot='key' type='nominal' />
            <column caption='Return To Work Days' datatype='real' name='[return_to_work_days]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0032291844165662]' derivation='User' name='[usr:Calculation_0032291844165662:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <style>
              <style-rule element='mark'>
                <encoding attr='color' field='[usr:Calculation_0032291844165662:nk]' type='palette'>
                  <map to='#bab0ac'>
                    <bucket>&quot;other&quot;</bucket>
                  </map>
                  <map to='#e15759'>
                    <bucket>&quot;maxdtc&quot;</bucket>
                  </map>
                  <map to='#edc948'>
                    <bucket>&quot;minrtw&quot;</bucket>
                  </map>
                  <map to='#f28e2b'>
                    <bucket>&quot;maxrtw&quot;</bucket>
                  </map>
                  <map to='#ff9da7'>
                    <bucket>&quot;mindtc&quot;</bucket>
                  </map>
                </encoding>
              </style-rule>
            </style>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
