      <aliases enabled='yes' />
      <column caption='Outstanding(Not Closed)' datatype='real' name='[Calculation_0032290415890432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] &lt;&gt; &quot;Closed&quot; THEN [outstanding_reserve] END' />
      </column>
      <column caption='IsOpen' datatype='integer' name='[Calculation_0032290418470913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Open&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Days to Close (closed only)' datatype='integer' name='[Calculation_0032290418700290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Closed&quot; THEN DATEDIFF(&apos;day&apos;,[injury_date],[closure_date]) END' />
      </column>
      <column caption='RTW Days (Closed only)' datatype='real' name='[Calculation_0032290419998723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Closed&quot; THEN [return_to_work_days] END' />
      </column>
      <column caption='Lodgement Lag (open + pending only)' datatype='integer' name='[Calculation_0032290422046724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] &lt;&gt; &quot;Closed&quot; THEN DATEDIFF(&apos;day&apos;,[injury_date],[lodgement_date]) END' />
      </column>
      <column caption='System Issue Label' datatype='string' name='[Calculation_0032290638819333]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [system_issue_flag] THEN &quot;System issue&quot; ELSE &quot;No system issue&quot; END' />
      </column>
      <column caption='Status Group (for avg vs median)' datatype='string' name='[Calculation_0032290639155206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Open&quot; THEN &quot;Open&quot; ELSE &quot;Closed / Pending&quot; END' />
      </column>
      <column caption='Total Claims' datatype='integer' name='[Calculation_0032290640576519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([claim_id])' />
      </column>
      <column caption='Total Members' datatype='integer' name='[Calculation_0032290641887240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([member_id])' />
      </column>
      <column caption='Still to Settle' datatype='real' name='[Calculation_0032290642878473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0032290415890432])' />
      </column>
      <column caption='% Open' datatype='real' name='[Calculation_0032290666217482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0032290418470913]) / COUNT([claim_id])' />
      </column>
      <column caption='Max Avg Review Overdue' datatype='string' name='[Calculation_0032291815923729]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([review_overdue_days]) = WINDOW_MAX(AVG([review_overdue_days])) then &apos;MAX&apos;&#10;ELSE &apos;OTHER&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
